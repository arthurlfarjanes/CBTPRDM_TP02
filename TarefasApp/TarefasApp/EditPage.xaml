<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.EditPage"
             Title="Editar Tarefa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Editar Tarefa" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <Label Text="Título:" FontAttributes="Bold" />
            <Entry x:Name="TituloEntry" />

            <Label Text="Descrição:" FontAttributes="Bold" />
            <Editor x:Name="DescricaoEditor" HeightRequest="100" />

            <Label Text="Prioridade:" FontAttributes="Bold" />
            <Picker x:Name="PrioridadePicker">
                <Picker.Items>
                    <x:String>Baixa</x:String>
                    <x:String>Média</x:String>
                    <x:String>Alta</x:String>
                </Picker.Items>
            </Picker>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,20,0,0">
                <Button Text="Cancelar" BackgroundColor="Gray" Clicked="OnCancelarClicked" />
                <Button Text="Salvar Alterações" BackgroundColor="#0078D4" Clicked="OnSalvarClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>