<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.EditPage"
             BackgroundColor="#FAFAFA"
             Title="Editar Tarefa">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="Editar Tarefa" FontSize="28" FontAttributes="Bold" TextColor="#4338CA" Margin="0,0,0,10" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Título" FontSize="14" FontAttributes="Bold" TextColor="#3F3F46" />
                <Border Stroke="#D4D4D8" StrokeThickness="1.5" BackgroundColor="#FFFFFF" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry x:Name="TituloEntry" TextColor="#09090B" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição" FontSize="14" FontAttributes="Bold" TextColor="#3F3F46" />
                <Border Stroke="#D4D4D8" StrokeThickness="1.5" BackgroundColor="#FFFFFF" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Editor x:Name="DescricaoEditor" TextColor="#09090B" BackgroundColor="Transparent" HeightRequest="120" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Prioridade" FontSize="14" FontAttributes="Bold" TextColor="#3F3F46" />
                <Border Stroke="#D4D4D8" StrokeThickness="1.5" BackgroundColor="#FFFFFF" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Picker x:Name="PrioridadePicker" TextColor="#09090B" BackgroundColor="Transparent">
                        <Picker.Items>
                            <x:String>Baixa</x:String>
                            <x:String>Média</x:String>
                            <x:String>Alta</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,30,0,0">
                <Button Text="Cancelar" Grid.Column="0" BackgroundColor="#F4F4F5" TextColor="#3F3F46" BorderColor="#D4D4D8" BorderWidth="1" CornerRadius="12" HeightRequest="54" FontAttributes="Bold" Clicked="OnCancelarClicked" />
                <Button Text="Atualizar" Grid.Column="1" BackgroundColor="#4338CA" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="54" FontAttributes="Bold" Clicked="OnSalvarClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>