<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TarefasApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TarefasApp"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#4338CA"
    Shell.TabBarUnselectedColor="#A1A1AA">

    <TabBar>
        <Tab Title="Tarefas">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="Créditos">
            <ShellContent ContentTemplate="{DataTemplate local:CreditosPage}" />
        </Tab>
    </TabBar>

</Shell>