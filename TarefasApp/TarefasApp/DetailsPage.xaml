<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.DetailsPage"
             Title="Detalhes da Tarefa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Título:" FontAttributes="Bold" TextColor="Gray" />
            <Label Text="{Binding Titulo}" FontSize="22" FontAttributes="Bold" />

            <Label Text="Descrição:" FontAttributes="Bold" TextColor="Gray" />
            <Label Text="{Binding Descricao}" FontSize="16" />

            <Label Text="Data de Criação:" FontAttributes="Bold" TextColor="Gray" />
            <Label Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="16" />

            <Label Text="Prioridade:" FontAttributes="Bold" TextColor="Gray" />
            <Label Text="{Binding Prioridade}" FontSize="16" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,30,0,0">
                <Button Text="Editar" Grid.Column="0" BackgroundColor="#FFC107" TextColor="Black" Clicked="OnEditarClicked" />
                <Button Text="Excluir" Grid.Column="1" BackgroundColor="#DC3545" TextColor="White" Clicked="OnExcluirClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>