<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.DetailsPage"
             BackgroundColor="#FAFAFA"
             Title="Detalhes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Border Stroke="#E4E4E7" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#09090B" Offset="0,4" Radius="8" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout>
                        <Label Text="Título" FontSize="12" FontAttributes="Bold" TextColor="#A1A1AA" TextTransform="Uppercase" />
                        <Label Text="{Binding Titulo}" FontSize="24" FontAttributes="Bold" TextColor="#09090B" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Descrição" FontSize="12" FontAttributes="Bold" TextColor="#A1A1AA" TextTransform="Uppercase" />
                        <Label Text="{Binding Descricao}" FontSize="16" TextColor="#3F3F46" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Prioridade" FontSize="12" FontAttributes="Bold" TextColor="#A1A1AA" TextTransform="Uppercase" />
                            <Border Stroke="#E4E4E7" StrokeThickness="1" BackgroundColor="#F4F4F5" HorizontalOptions="Start" Padding="12,4" Margin="0,4,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Prioridade}" FontSize="14" FontAttributes="Bold" TextColor="#18181B" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Data de Criação" FontSize="12" FontAttributes="Bold" TextColor="#A1A1AA" TextTransform="Uppercase" />
                            <Label Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="14" TextColor="#71717A" Margin="0,4,0,0" VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Text="Editar" Grid.Column="0" BackgroundColor="#FFFFFF" TextColor="#18181B" BorderColor="#E4E4E7" BorderWidth="1" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" Clicked="OnEditarClicked" />
                <Button Text="Excluir" Grid.Column="1" BackgroundColor="#EF4444" TextColor="#FAFAFA" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" Clicked="OnExcluirClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>