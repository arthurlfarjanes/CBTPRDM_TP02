<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.MainPage"
             BackgroundColor="#FAFAFA"
             Title="Minhas Tarefas">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,10,20,20">

        <Label Text="Tarefas" FontSize="32" FontAttributes="Bold" TextColor="#09090B" Margin="0,10,0,20" Grid.Row="0" />

        <CollectionView x:Name="TarefasCollection" SelectionMode="Single" SelectionChanged="OnTarefaSelected" Grid.Row="1">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,60,0,0">
                    <Label Text="📭" FontSize="64" HorizontalOptions="Center" Opacity="0.8" />
                    <Label Text="Nenhuma tarefa encontrada" FontSize="20" FontAttributes="Bold" TextColor="#3F3F46" HorizontalOptions="Center" />
                    <Label Text="Toque no botão abaixo para cadastrar a primeira." FontSize="14" TextColor="#A1A1AA" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E4E4E7" StrokeThickness="1" BackgroundColor="#FFFFFF" Margin="0,0,0,12" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#4338CA" Offset="0,2" Radius="6" Opacity="0.08" />
                        </Border.Shadow>
                        <VerticalStackLayout>
                            <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" TextColor="#09090B" Margin="0,0,0,4" />
                            <Label Text="{Binding Descricao}" FontSize="14" TextColor="#71717A" MaxLines="2" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="+ Adicionar Nova Tarefa" 
                Grid.Row="2" 
                BackgroundColor="#4338CA" 
                TextColor="#FFFFFF" 
                FontAttributes="Bold" 
                CornerRadius="12" 
                HeightRequest="54" 
                Margin="0,10,0,0" 
                Clicked="OnAdicionarClicked" />
    </Grid>
</ContentPage>